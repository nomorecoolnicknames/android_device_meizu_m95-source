
# WMT combo-chip state (persist.mtk.wcn.*, service.wcn.*) — set by the wmt
# loader chain, read by the wifi/bt stack. [CONV]
vendor_restricted_prop(wmt_prop)

# GPS daemon state. [CONV]
vendor_internal_prop(mnld_prop)

# Modem state (ril.active.md, mtk.md*). [CONV]
vendor_restricted_prop(mtk_md_prop)

# ctl. ACL for the MTK radio service zoo (ctl.ccci*, ctl.ril-*, ctl.muxreport*,
# ctl.*mdlogger*, ctl.gsm0710muxd*): one type instead of the m681 template's
# 25 separate ctl_*_prop types — property_contexts prefixes cover the set. [CONV]
vendor_internal_prop(ctl_mtk_radio_prop)

# nvram_daemon readiness flag (service.nvram_init). [CONV]
vendor_restricted_prop(nvram_prop)

# MTK log daemons (persist.mtklog.*, debug.mdlogger.*). [CONV]
vendor_internal_prop(mtklog_prop)

# AKM compass driver control flags (nosecure.akm.*), set by the sensor HAL.
# These land on default_prop otherwise, which no HAL may set. [CONV]
vendor_internal_prop(m95_sensor_prop)

# PQ (picture-quality) tuning knobs: persist.sys.pq.* and debug.pq.*. Without a
# type of their own they fall on system_prop/debug_prop, which the pq domain
# may not set, and every boot loses the tuning and logs an error per knob. [CONV]
vendor_restricted_prop(m95_pq_prop)

# Wi-Fi 5G capability flag published by nvram_daemon (ro.wlan.mtk.*). [CONV]
vendor_restricted_prop(m95_wlan_prop)

# volte daemon control pairs, set by mtkmal. [FACT 2026-08-18 census #2:
# denied { set } property=ctl.stop$volte_{stack,ua,imcb} from u:r:mtkmal:s0,
# tcontext=ctl_stop_prop] Exact ctl.start$/ctl.stop$ entries beat the generic
# prefixes (see the ril-daemon note below in property_contexts), so this
# hands mtkmal control of the three VoLTE daemons only, not ctl_stop_prop
# wholesale.
vendor_internal_prop(ctl_volte_prop)

# MAL LTE-handover flag. [FACT 2026-08-18 census #2: denied { set }
# property=net.handover.thlte tcontext=system_prop] Typed so a vendor daemon
# does not get system_prop wholesale; "net.handover." is longer than plat's
# "net." prefix, so this binding wins the lookup. No reader of the property
# exists in our system image today; a reader would census a read denial.
vendor_internal_prop(m95_handover_prop)

# Forge bring-up knobs: persist.forge.* (ims_single_transport, ims_modem_kick,
# ims_pdn_holder, ims_auto_recover, ims_kick_ril, ims_reg_watch_idle_min,
# volte_kicker). Read by ForgeImsService, which runs in the `radio` domain, and
# by init (init.m95.volte.rc:68 triggers on persist.forge.volte_kicker=1).
# Without a type of their own they land on default_prop, which AOSP grants no
# domain a read on -- so the alternative is get_prop(radio, default_prop), a
# grant on every unlabelled property on the device. [CONV]
vendor_restricted_prop(m95_forge_prop)

vendor_restricted_prop(m95_volte_svc_prop)

# MTK vendor telephony/IMS knobs that a CORE process has to read.
#
# Повод -- разбор линии volte-review; состояние уточнено замером собранной
# политики. private/property_contexts:195 метит `persist.vendor.` типом
# vendor_default_prop. У private/domain.te две ветки: при
# PRODUCT_COMPATIBLE_PROPERTY=true грант сужается до
# get_prop({ domain -coredomain -appdomain }, vendor_default_prop), и домен
# radio исключён поимённо (private/radio.te:1 делает его coredomain).
#
# **Сегодня на этом аппарате дыры НЕТ** (FACT, замер собранной политики):
# в plat_sepolicy.cil стоит (allow domain vendor_default_prop (file (read
# getattr map open))) -- активна ветка compatible_property_not_set, потому что
# PRODUCT_COMPATIBLE_PROPERTY = false (`get_build_var`), потому что эффективный
# PRODUCT_SHIPPING_API_LEVEL = 25: lineage_m95.mk:42 тянет
# product_launched_with_n_mr1.mk ПОСЛЕ device.mk:65, где стоит 30.
#
# Тип заведён не «чтобы починить», а чтобы поломка не пришла молча при первой
# же правке уровня API: 30 -- то, что дерево уже считает своим уровнем (комментарий
# в device.mk:63-64, комментарий в manifest.xml:185), и в день, когда это станет
# правдой, radio разом потеряет и default_prop, и vendor_default_prop.
# com.mediatek.ims (домен radio) читает как минимум шесть таких свойств:
# persist.vendor.ims_support, persist.vendor.mims_support,
# persist.vendor.ims.simulate, persist.vendor.mtk.volte.enable,
# persist.vendor.mtk.wfc.enable, persist.vendor.mtk_wfc_support.
#
# Два из них поведенческие, а не косметические: ImsCommonUtil.supportMdAutoSetupIms()
# гейтит enableImsAdapter в initImsAvailability, supportMims() -- дискриминатор
# транспорта. SystemProperties.get исключений не бросает, поэтому под enforcing
# отказ вернул бы ДЕФОЛТ, и ветка выбралась бы случайно, без единой строки в
# логе. Ровно класс `dontaudit-hides-real-failures`.
#
# Своим типом, а не get_prop(radio, vendor_default_prop): последнее отдало бы
# radio каждое вендорное свойство на аппарате. Вендорные читатели ничего не
# теряют -- ниже воспроизведён тот же самый набор, что им давала платформа. [CONV]
vendor_restricted_prop(m95_ims_vendor_prop)


# MTK feature/config switches: ro.mtk_*, persist.mtk_*, persist.mtk.*,
# mtk.eccci.*, ro.telephony.sim.count, persist.chiptest*, the legacy
# rild.libpath/libargs pair. Set by vendor/build.prop (vendor_init), read by
# every MTK vendor daemon and HAL. Restricted, not internal, only so that a
# core reader can be granted later without redeclaring the type; none is
# known today (the IMS APK sources carry persist.mtk_epdg_support only in a
# commented-out line, XcapMobileDataNetworkManager.java:271).
vendor_restricted_prop(m95_mtk_config_prop)

# MTK RIL/MAL/MUX state shared between vendor daemons: ril.first.md,
# ril.external.md, ril.telephony.mode, ril.mal*, ril.volte.mal.*, ril.mux*,
# ril.getccci.response, ril.pid.*, ril.phone{1,2}.mapped.md, ril.epdg.*,
# ril.data.mal, ril.rilproxy, ril.emulation.userload, persist.radio.mtk_*,
# persist.radio.mnl.prop. On radio_prop only rild could read them; mtkmal,
# gsm0710muxd, ccci_mdinit, mnld, epdg_wod, the audio HAL and vendor_init
# could not (neverallow, compatible_property_only block). gsm.* names stay on
# radio_prop: the framework reads them and rild already owns them.
vendor_restricted_prop(m95_mtk_ril_prop)

# init.svc.<name> of two vendor services that vendor code polls:
# init.svc.ril-proxy (ccci_mdinit) and init.svc.goodixfpd (a vendor rc
# trigger). The plat catch-all init_service_status_private_prop is
# system_internal. Same pattern as m95_volte_svc_prop above.
vendor_restricted_prop(m95_vendor_svc_prop)

# sys.usb.vid: set by init.mt6797.usb.rc and expanded (${sys.usb.vid}) in the
# same file, i.e. read and written only by vendor_init. On the plat `sys.`
# prefix it is system_prop.
vendor_internal_prop(m95_usb_prop)

vendor_internal_prop(m95_hwc_debug_prop)

# ro.vendor.vintf.legacy_kernel: set in vendor/build.prop, read by
# system_server -- frameworks/base core/jni/android_os_VintfObject.cpp:106
# (branch meizu-legacy-vendor) skips the kernel-config check with it, which is
# what keeps the "internal problem" dialog away (commit cc14611). On
# vendor_default_prop (vendor_internal) a core read is neverallowed, so under
# enforcing the read would return false and the dialog would come back.
# FACT: denied { read } scontext=system_server tcontext=vendor_default_prop,
# capture m95-boot-20260924-192234.
vendor_restricted_prop(m95_exported_vendor_prop)


# MTK audio-HAL state and feature switches: af.modem_{1,2,ext}.status,
# af.recovery.{dl,ul,mic}_mute_on, af.rf_{info,mode}, af.ril.* (speech codec,
# HD voice), af.mixer.pcm, af.track.pcm, af.karaoke.*, af.resouce.*,
# persist.af.* (13 names). Only audio.primary.mt6797.so carries them (strings
# of mtk-ril, librilmtk, librilimp, mtkmal, libmal and the volte daemons have
# no af.* at all); AudioFlinger's own af.* names (af.fast_track_multiplier,
# af.tee, af.thread.throttle, af.patch_park, af.resampler.quality --
# frameworks/av) are different names and stay where they are. On default_prop
# the HAL can neither read nor set them under A13.
vendor_internal_prop(m95_audio_hal_prop)

# VoLTE stack bookkeeping: net.ims.ipsec.version, net.ims.volte.pid (strings
# of volte_stack) and service.ims.icsi.* (volte_ua, volte_stack). The plat
# `net.` and `service.` prefixes make them system_prop, which a vendor daemon
# may neither read nor set.
vendor_internal_prop(m95_volte_prop)

# persist.camera.* -- switches of the camera provider (hal_camera_default):
# hardware/interfaces camera/common/1.0/default/CameraModule.cpp reads
# big_yuv (:306), reprocessing (:390), fake_raw (:490), raw_front (:496),
# native_jpeg (:580); libm95_camera_metadata_raw, loaded into the provider by
# the linker shim (BoardConfig.mk TARGET_LD_SHIM_LIBS), reads raw
# (camera_metadata_raw/m95_scaler_raw.cpp:178). vendor/build.prop sets
# big_yuv, fake_raw, raw_front and raw. A13 has no platform entry for the
# prefix, so the names fall on default_prop: vendor_init could not set them
# from build.prop and the provider could not read them -- RAW16 and the big
# YUV table would switch off without an avc line (build.prop is loaded before
# init's SELinux logging). frameworks/av has no "persist.camera." literal, so
# cameraserver is not a reader. Restricted rather than internal so a
# diagnostic core reader can be granted later; setting them by hand needs
# `adb root` (su), as it did on default_prop.
vendor_restricted_prop(m95_camera_prop)

# Performance profile switch and its sub-switches (persist.vendor.m95.
# perfprofile, .big, .park), read once by the m95_cpuset patrol at start
# (rootdir/m95-perfprofile.sh). Set by hand with `adb root`; nothing else
# reads or sets them.
vendor_internal_prop(m95_perfprofile_prop)

# Power trap switch (persist.vendor.m95.powertrap), rootdir/init.m95.powertrap.rc.
# Set by hand with `adb root`; read by the m95_powertrap service.
vendor_internal_prop(m95_powertrap_prop)
