+uint8_t * convertHexStringToBytes(void *response, size_t *responseLen) {
+    // The MTK N blob (mtk-ril.so) hands +CMT/+CDS PDUs over straight from the
+    // AT line buffer, with NUL/CR/LF from the line split inside the reported
+    // length (log: "invalid hex char 0 10" = NUL, LF; the SMS was dropped and
+    // never acked).  Skip leading NUL/whitespace, parse up to the next NUL,
+    // drop trailing whitespace; *responseLen gets the hex length used.
+    uint8_t *hexString = (uint8_t *)response;
+    size_t len = *responseLen;
+    while (len > 0 && (hexString[0] == '\0' || isspace(hexString[0]))) {
+        hexString++;
+        len--;
+    }
+    len = strnlen((const char *)hexString, len);
+    while (len > 0 && isspace(hexString[len - 1])) len--;
+    if (len != *responseLen) {
+        RLOGW("convertHexStringToBytes: trimmed hex length %zu -> %zu", *responseLen, len);
+    }
+    *responseLen = len;
+    if (len == 0 || len % 2 != 0) {
+        RLOGE("convertHexStringToBytes: bad hex length %zu", len);
         return NULL;
     }
 
