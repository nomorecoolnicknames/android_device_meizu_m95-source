// m95 vendor shims (phase 1). Built as vendor_shared_lib, installed to
// /vendor/lib{,64} via PRODUCT_PACKAGES in phase 2 (device.mk) together
// with TARGET_LD_SHIM_LIBS entries. See VENDOR_A11_BLOB_AUDIT.md for the
// per-symbol evidence (UND -> provider mapping from Ghidra + readelf).
cc_defaults {
    name: "m95shim_defaults",
    vendor: true,
    cflags: ["-Wno-unused-parameter"],
}

cc_library_shared {
    name: "libm95shim_gui",
    defaults: ["m95shim_defaults"],
    srcs: ["gui.cpp"],
    shared_libs: ["liblog"],
    // No shared_libs: both symbols declared manually and resolved at
    // runtime under VNDK-lite (see gui.cpp). Linking system libgui here
    // is a build-time VNDK violation.
    allow_undefined_symbols: true,
}

// libgui_m95.so / libsensor_m95.so: the sonames the rewired N blobs NEED
// (libgui_m95: 26 lib + 21 lib64 consumers -- hwcomposer.mt6797, libgui_ext,
// libperfservice, camera, VoLTE; libsensor_m95: libmtkcam_sysutils,
// libmpe.sensorlistener). On 18.1 these names were libgui_vendor and
// libsensor_vendor themselves, renamed with `stem` inside frameworks/native
// (18.1 commits 6a044e7, 4c9aeee). This tree ships libgui_vendor
// (frameworks/native/libs/gui/Android.bp) and libsensor_vendor
// (hardware/lineage/compat/Android.bp) under their own names, and a second
// libgui cannot be built from here: libgui_defaults' srcs resolve against
// THIS directory (build/soong/android/paths.go:1433-1447). So each is an
// empty library whose only content is DT_NEEDED on the real one. bionic binds
// every library against the whole breadth-first local group
// (bionic/linker/linker.cpp:730-756, 1794-1810), so the consumers' symbols
// land in the ONE libgui_vendor of the process. Soong links without

// m95_linkaudit.py, all 47 libgui_m95 consumers): the same 262 symbols bind
// to libgui_vendor.so as with a symlink, one libgui instance per process.
cc_library_shared {
    name: "libgui_m95",
    defaults: ["m95shim_defaults"],
    srcs: ["stub.cpp"],
    shared_libs: ["libgui_vendor"],
}

cc_library_shared {
    name: "libsensor_m95",
    defaults: ["m95shim_defaults"],
    srcs: [
        "stub.cpp",
        "sensor.cpp",
    ],
    shared_libs: [
        "libsensor_vendor",
        "liblog",
    ],
}

cc_library_shared {
    name: "libm95shim_power",
    defaults: ["m95shim_defaults"],
    srcs: ["power.cpp"],
}

cc_library_shared {
    name: "libm95shim_audioutils",
    defaults: ["m95shim_defaults"],
    srcs: ["audioutils.cpp"],
    // String8::String8() resolved from the system libutils at runtime (lite).
    allow_undefined_symbols: true,
}

cc_library_shared {
    name: "libm95shim_ui",
    defaults: ["m95shim_defaults"],
    srcs: ["ui.cpp"],
    // Manual declarations only (see gui.cpp): N-ABI entries defined here,
    // R-ABI targets resolved at runtime under VNDK-lite. libsync/liblog are
    // LLNDK (Fence waits and logs); libui is reached with dlsym, not linked.
    shared_libs: [
        "libdl",
        "liblog",
        "libsync",
    ],
    allow_undefined_symbols: true,
}

cc_library_shared {
    name: "libm95shim_utils",
    defaults: ["m95shim_defaults"],
    srcs: [
        "utils.cpp",
        "propertymap.cpp",
    ],
    shared_libs: ["libutils"],
    // MemoryHeapBase forwarders resolve R libbinder ctors at runtime (lite).
    allow_undefined_symbols: true,
}

cc_library_shared {
    name: "libm95shim_sf",
    defaults: ["m95shim_defaults"],
    srcs: ["sf.cpp"],
}

// N-layout android::Parcel "box" for the stock MTK libril (librilimp.so). The
// blob keeps 104-byte (Nougat) Parcels on the stack/heap; the A13 Parcel is 120
// and overruns them (rild SIGSEGV, capture m95-b16-rild-crash-20260924). Its 19
// Parcel imports are renamed to android::Pbrcel in .dynstr (tools/
// librilimp-box-nparcel.py) and resolve HERE; each proxies to a heap-allocated
// real Parcel whose pointer lives in the first 8 bytes of the blob's box. See
// nparcel.cpp for the safety argument (no inline field access, no Parcel across
// the librilimp boundary).
cc_library_shared {
    name: "libm95shim_nparcel",
    defaults: ["m95shim_defaults"],
    srcs: ["nparcel.cpp"],
    shared_libs: [
        "libbinder",
        "libutils",
        "liblog",
    ],
}

// N-layout android::Region for the Mali EGL driver (see region.cpp). Mali's
// libui.so DT_NEEDED is redirected to this library by wire-shims.py.
cc_library_shared {
    name: "libm95shim_region",
    defaults: ["m95shim_defaults"],
    srcs: ["region.cpp"],
    header_libs: ["libutils_headers", "liblog_headers"],
    shared_libs: ["liblog"],
    cflags: ["-fvisibility=hidden"],
}

cc_library_shared {
    name: "libm95shim_net",
    defaults: ["m95shim_defaults"],
    srcs: ["net.c"],
}

// libnetd_client.so — setNetworkForSocket for volte_stack (and wfca), forwarded
// to the LLNDK android_setsocknetwork (see netd_client.c). Without it
// volte_stack cannot link, and volte_ua / volte_imcb exit 245 waiting for its
// socket (capture m95-b19-volte-20260925). ELF32 only: every consumer of this
// symbol is 32-bit; the 64-bit one (lib64/libcharon.so) wants protectFromVpn.
cc_library_shared {
    name: "libm95shim_netd_client",
    defaults: ["m95shim_defaults"],
    stem: "libnetd_client",
    srcs: ["netd_client.c"],
    shared_libs: ["libandroid_net"],
    compile_multilib: "32",
}

// libm95probe is NOT linked by anything at build time; six blobs still NEED it
// via patchelf --add-needed (vendor-18.1/wire-shims.py). Empty since

cc_library_shared {
    name: "libm95probe",
    defaults: ["m95shim_defaults"],
    srcs: ["probe.c"],
}

// libm95trace is a MANUAL diagnostic (LD_PRELOAD tracer), never installed
// to images and never in PRODUCT_PACKAGES. Build with `m libm95trace`,
// push the .so to /cache, run services with LD_PRELOAD from TWRP.
cc_library_shared {
    name: "libm95trace",
    defaults: ["m95shim_defaults"],
    srcs: ["trace.c"],
    shared_libs: ["libdl"],
}


// Same blobs, same holes; R only widened them (libnetutils lost
// ifc_set_throttle, BoringSSL lost SSLv3). `stem` keeps the DT_NEEDED / dlopen
// filename the blob expects while the Soong module name stays unique
// (libfs_mgr / libskia are taken by static modules in R).

// libfs_mgr.so — N-layout fstab reader for libnvram.so (32+64). Without it
// nvram_daemon, ccci_mdinit/ccci_fsd (modem), mnld, nvram_agent_binder and the
// camera closure cannot load ("library libfs_mgr.so not found").
cc_library_shared {
    name: "libm95shim_fs_mgr",
    defaults: ["m95shim_defaults"],
    stem: "libfs_mgr",
    srcs: ["fs_mgr.c"],
}

// libskia.so — empty DT_NEEDED placebo for libcam.camadapter.so and four other

cc_library_shared {
    name: "libm95shim_skia",
    defaults: ["m95shim_defaults"],
    stem: "libskia",
    srcs: ["skia.cpp"],
}

// Overlink placebos for system-only libraries under strict VNDK (stub.cpp has
// the consumer counts and the evidence path). Unique names on purpose: unlike
// libskia there IS a system copy, and the blobs with real imports must keep
// resolving to it until their vendor replacement exists.
cc_library_shared {
    name: "libm95shim_camera_client",
    defaults: ["m95shim_defaults"],
    srcs: ["stub.cpp"],
}

cc_library_shared {
    name: "libm95shim_media",
    defaults: ["m95shim_defaults"],
    srcs: ["stub.cpp"],
}

cc_library_shared {
    name: "libm95shim_mediautils",
    defaults: ["m95shim_defaults"],
    srcs: ["stub.cpp"],
}

cc_library_shared {
    name: "libm95shim_android_runtime",
    defaults: ["m95shim_defaults"],
    srcs: ["android_runtime.cpp"],
}


// placebos and JNI shims that close the camera chain
// (camera.mt6797.so -> libcam.paramsmgr -> libcam.common.meizu -> libandroid /
// libjnigraphics / libandroid_runtime / libmeizucamera) and the audio HAL's
// dlopened libaudio_param_parser.so (libicuuc/libicui18n, zero symbols).
cc_library_shared {
    name: "libm95shim_icuuc",
    defaults: ["m95shim_defaults"],
    srcs: ["stub.cpp"],
}

cc_library_shared {
    name: "libm95shim_icui18n",
    defaults: ["m95shim_defaults"],
    srcs: ["stub.cpp"],
}

cc_library_shared {
    name: "libm95shim_android",
    defaults: ["m95shim_defaults"],
    srcs: ["android.c"],
}

cc_library_shared {
    name: "libm95shim_drmframework",
    defaults: ["m95shim_defaults"],
    srcs: ["stub.cpp"],
}

cc_library_shared {
    name: "libm95shim_stagefright",
    defaults: ["m95shim_defaults"],
    srcs: ["stub.cpp"],
}

cc_library_shared {
    name: "libm95shim_jnigraphics",
    defaults: ["m95shim_defaults"],
    srcs: ["jnigraphics.c"],
}

// libbt-vendor.so (64-bit only) — the vendor interface the HIDL BT HAL
// dlopen()s; Flyme shipped it ELF32 only. Forwards to the 64-bit
// libbluetooth_mtk.so Meizu did ship. The 32-bit blob stays at
// /vendor/lib/libbt-vendor.so (m95-vendor.mk).
cc_library_shared {
    name: "libm95shim_btvendor",
    defaults: ["m95shim_defaults"],
    stem: "libbt-vendor",
    srcs: ["bt_vendor.c"],
    compile_multilib: "64",
    shared_libs: ["liblog", "libdl"],
}

// SSLv3_{client,server}_method for mtk_agpsd and libcurl-ss (see ssl.c).
cc_library_shared {
    name: "libm95shim_ssl",
    defaults: ["m95shim_defaults"],
    srcs: ["ssl.c"],
    // libssl stays a dependency so it loads right after this shim; every
    // libssl/libcrypto call is resolved with dlsym(RTLD_NEXT) (see ssl.c).
    shared_libs: ["libssl", "liblog", "libdl"],
}

// No-op pthread_mutex_destroy for mnld (ELF32): libmnl.so destroys its
// session mutex twice, bionic FORTIFY-aborts (see pthread.c). Prepended to
// mnld's DT_NEEDED by wire-shims.py so it precedes libc for the whole process.
cc_library_shared {
    name: "libm95shim_mnld",
    defaults: ["m95shim_defaults"],
    srcs: ["pthread.c"],
    compile_multilib: "32",
}

// libperfservicenative.so replacement (see perfservice.c): MTK PerfService
// client that succeeds locally; the stock blob deadlocks the camera provider
// (CpuCtrlImp) without the perfservice daemon. Blob copies removed from

cc_library_shared {
    name: "libm95shim_perfservice",
    defaults: ["m95shim_defaults"],
    stem: "libperfservicenative",
    srcs: ["perfservice.c"],
}

// VoLTE log filter (see volte_log.c): drops INFO-and-below lines of VoLTE*
// tags -- whole SIP messages with IMSI/IMEI/numbers -- in volte_stack,
// volte_ua and volte_imcb. 32-bit: the three daemons are 32-bit. Installed
// and wired (TARGET_LD_SHIM_LIBS) only with M95_VOLTE_LOGFILTER=true.
cc_library_shared {
    name: "libm95volte_logfilter",
    defaults: ["m95shim_defaults"],
    srcs: ["volte_log.c"],
    shared_libs: ["liblog"],
    compile_multilib: "32",
    cflags: ["-Wall", "-Werror"],
}
