# M95 — closing the permissive census #2 (2026-08-15).
#
# Context: with the kernel v30-xperm fix flashed and init's seclabel handling
# repaired (ueventd now runs as u:r:ueventd:s0 instead of u:r:init:s0), the
# boot-window denial count fell from 1345 to 91 and ioctl denials from
# hundreds to one. What follows closes the remainder, grouped by what the
# denial actually means.

# The modem filesystem daemon owns /data/md3 (modem NVRAM + GPS working files).
type ccci_data_file, file_type, data_file_type, core_data_file_type;

# /dev/block/mmcblk0p8 is the nvcfg partition. Its sibling nvdata (p9) already
# has a type; nvcfg never got one, so e2fsck hit generic block_device, which
# domain.te:410 forbids widening.
type nvcfg_device, dev_type;

# /dev/mtk-adc-cali is the ADC calibration node nvram_daemon writes. It carried
# the generic `device` label, and allowing a daemon on `device` would cover every
# unlabelled node in /dev, so it gets a type of its own.
type mtk_adc_cali_device, dev_type;

##############################################################################
# memtrack: reads ion/mali statistics out of debugfs.
# Deliberately NOT allowed — debugfs is not a stable interface and AOSP policy
# keeps HALs out of it. The HAL degrades gracefully (it reports no per-process
# graphics memory). dontaudit, so the denial stays enforced but silent; this
# was the single largest group at 40 lines per boot.
##############################################################################
dontaudit hal_memtrack_default debugfs:dir { search read open getattr };
dontaudit hal_memtrack_default debugfs:file { read open getattr };

##############################################################################
# ccci_fsd: the modem filesystem daemon. It owns /data/md3 (modem NVRAM and
# the GPS working files: MF5U_001, MF80_001, gps). These reads are legitimate
# — without them the modem cannot load its calibration.
##############################################################################
# /data/md3 gets its own label (see file_contexts + the type below); writing
# generic system_data_file is forbidden by a neverallow in domain.te:1181, and
# rightly so - widening it would let the modem daemon write anywhere in /data.
allow ccci_fsd ccci_data_file:dir { read write open search getattr add_name remove_name };
allow ccci_fsd ccci_data_file:file { read write open getattr create unlink setattr };

##############################################################################
# init: creating the by-name block-device symlinks during first stage.
# Every one of these is init labelling a node it just created itself.
##############################################################################
allow init {
    lk_block_device
    logo_block_device
    mdimg_block_device
    nvram_device
    proinfo_block_device
    protect_f_device
    seccfg_block_device
    userdata_block_device
}:lnk_file relabelto;

allow init tmpfs:lnk_file create;
allow init sysfs:file setattr;
allow init sysfs_ccci:file setattr;

##############################################################################
# Small, single-denial items with a clear owner.
##############################################################################
allow mnld sysfs:file { open read };
# R-SPLIT-DROP (netd is coredomain; private/coredomain.te:99 forbids core
# domains touching unlabelled sysfs. AOSP public/netd.te:55,58 already give
# netd r_dir_file + w_file_perms on sysfs_net, and private/genfs_contexts:134
# labels /devices/virtual/net sysfs_net -- so this rule is only needed if the
# ccmni nodes hang off a platform path outside that genfscon. Measure with
# `readlink -f /sys/class/net/ccmni0` and add a genfscon, never a core grant):
# allow netd sysfs:file write;
allow viarild proc_cmdline:file { read open };
allow wmt_loader mtk_wmt_proc:file setattr;
allow vendor_init system_data_file:dir setattr;

##############################################################################
# webview_zygote talking to zygote over a datagram socket is an AOSP-internal
# handshake that is denied on stock Pie too; silence rather than widen.
##############################################################################
dontaudit webview_zygote zygote:unix_dgram_socket { read write };

##############################################################################
# Round 2 (census #3, 44 denials left). Each rule below comes from a captured
# denial with its path, not from guessing.
##############################################################################

# netd reads/writes the modem interface MTU: /sys/devices/virtual/net/ccmni0/mtu
# R-SPLIT-DROP (same as the write above -- covered by AOSP netd.te + sysfs_net):
# allow netd sysfs:file { open read };

# mnld powers the GNSS chip through /sys/.../pwrctl
allow mnld sysfs:file write;

# emdlogger reads its own config: /data/mdlog/emdlogger_usb_config.prop
allow emdlogger system_data_file:file { read open getattr };

# gsm0710muxd sets up the modem PTYs and /dev/radio
allow gsm0710muxd device:dir write;
allow gsm0710muxd devpts:chr_file setattr;
allow gsm0710muxd sysfs_ccci:dir search;
allow gsm0710muxd self:capability chown;

# viarild drops privileges and reads the kernel command line
allow viarild self:capability setuid;
allow viarild proc_cmdline:file getattr;

# camera HAL reads the board revision: /sys/bus/platform/drivers/dev_info/dev_info
allow hal_camera_default sysfs_dev_info:file { read open };

# audio HAL watches the headset switch: /sys/devices/virtual/switch/h2w/state
allow hal_audio_default sysfs_switch:dir search;
allow hal_audio_default sysfs_switch:file { read open };
allow hal_audio_default media_rw_data_file:dir search;

# nvram_daemon shells out during first-boot NVRAM setup
allow nvram_daemon shell_exec:file { read open execute execute_no_trans };

# thermal_manager talks to the MTK thermal zone driver at /proc/mtktz/mtktscpu.
# TODO: this deserves a genfscon label of its own rather than generic proc.
allow thermal_manager proc:file { read write open };

# fuelgauged logs to /dev/kmsg
allow fuelgauged kmsg_device:chr_file { write open };

# DRM HAL is a vendor service and legitimately uses /dev/vndbinder
allow hal_drm_default vndbinder_device:chr_file { read write open ioctl };

# init relabels the device nodes it creates in first stage. The specific list
# above did not cover them all; this is the AOSP-standard form.
allow init dev_type:lnk_file relabelto;

# rild asking for dac_override is a stock-blob habit, not something we widen.
# Left denied and silenced; falsifier recorded in rild.te.
dontaudit rild self:capability dac_override;

##############################################################################
# Round 3 (census #4). The previous round's denials are gone; these are the
# next layer, previously masked because the boot never got this far cleanly.
##############################################################################

# e2fsck checks /nvdata (mmcblk0p9) and mmcblk0p8 before they are mounted
allow fsck nvdata_device:blk_file { read write open ioctl getattr };
allow fsck nvcfg_device:blk_file { read write open ioctl getattr };

# init relabels device symlinks in both directions during first stage
allow init dev_type:lnk_file { relabelfrom relabelto };
allow init block_device:lnk_file { relabelfrom relabelto };

# init exec'ing /system/bin/sh without a domain transition is forbidden by a
# neverallow in init.te:518 - and rightly: it would let init run arbitrary shell
# code in its own domain. NOT granted. The correct fix is to turn whatever rc
# line does this into a proper service with its own seclabel. Silenced here so
# the census stays readable; recorded as an enforcing blocker.
dontaudit init shell_exec:file execute_no_trans;
allow nvram_daemon shell_exec:file getattr;
allow nvram_daemon rootfs:dir read;

# GNSS HAL is a vendor service and legitimately uses /dev/vndbinder,
# exactly like the DRM HAL above.
allow hal_gnss_default vndbinder_device:chr_file { read write open ioctl };

# mtkmal drops privileges and reads the nvram property namespace
allow mtkmal self:capability setuid;
allow mtkmal nvram_prop:file { read open getattr map };

# sensors HAL reads its gyro-bias calibration: /data/iNemoEngine_gbias.dat
allow hal_sensors_default system_data_file:file { read open getattr };

# ccci_mdinit reads the board revision and the modem log config
allow ccci_mdinit sysfs_dev_info:file { read open getattr };
allow ccci_mdinit system_data_file:file { read open getattr };

# emdlogger uses a FIFO under /data/mdlog
allow emdlogger system_data_file:fifo_file { read write open getattr };

# mcd's netlink socket to the trustzone driver
allow mcd self:netlink_socket { create bind read write setopt };

# wmt_loader asking for dac_override is a stock-blob habit; keep it denied
# and silent rather than widening root capabilities for the combo-chip loader.
# 2026-08-16: this dontaudit hid a real failure. wmt_loader is root and
# /dev/wmtdetect was system:system 0660, so the open genuinely needed
# dac_override; silencing the audit meant that under enforcing the combo chip
# never came up and there was no denial to point at it. The node is now
# root-owned (ueventd.mt6797.rc), so the capability is not needed and the
# dontaudit is honest again: what remains is the blob asking out of habit.
dontaudit wmt_loader self:capability dac_override;

##############################################################################
# Round 4 (census #5, 23 denials left, 0 crashes). The three script domains
# from m95_scripts.te are live — m95_cpuset now appears as its own source
# domain, which is the proof the seclabel took effect.
##############################################################################

# init needs the full transition set, not just `transition`, to hand a service
# over to its domain: inherited rlimits, inherited signal state, and the
# no-at-secure flag.
# R-SPLIT: noatsecure has no exemption (init.te:617). Scripts need no
# LD_PRELOAD; plain transition set suffices under permissive.
allow init { m95_cpuset m95_bdaddr m95_fatal_capture }:process
    { transition rlimitinh siginh };

# the scripts themselves live in the ramdisk root
allow m95_cpuset rootfs:file { read open getattr };
allow m95_bdaddr rootfs:file { read open getattr };
allow m95_fatal_capture rootfs:file { read open getattr };

# composer is a vendor service and uses /dev/vndbinder, like the DRM and GNSS
# HALs already allowed above
allow hal_graphics_composer_default vndbinder_device:chr_file
    { read write open ioctl };

# rild drives the modem PTY that gsm0710muxd creates
allow rild devpts:chr_file { read write open ioctl getattr };

# the AGPS daemon talks to the modem over its own ccci tty
allow mtk_agpsd ccci_device:chr_file { read write open getattr };

# gsm0710muxd creates the modem PTY nodes and reads the ccci version
allow gsm0710muxd device:dir { add_name remove_name };
allow gsm0710muxd sysfs_ccci:file { read open getattr };
allow gsm0710muxd self:capability fowner;

# fingerprint HAL registers itself
allow hal_fingerprint_default servicemanager:binder call;

# wmt_loader chowns the combo-chip nodes it creates
allow wmt_loader self:capability chown;

##############################################################################
# Round 5 (census #6, 19 denials left, 0 crashes). All singles and pairs now.
##############################################################################

# fuelgauged listens on netlink for battery uevents
allow fuelgauged self:netlink_socket { create bind read write };

# gsm0710muxd symlinks the modem PTYs it created
allow gsm0710muxd device:lnk_file { create unlink };

# nvram_daemon shells out via toybox from the ramdisk root
allow nvram_daemon toolbox_exec:file getattr;
allow nvram_daemon rootfs:dir open;

# AGPS daemon does a termios ioctl on its modem tty
allow mtk_agpsd ccci_device:chr_file ioctl;

# audio HAL reads the modem version and the nvram property namespace —
# it needs the modem's audio calibration
allow hal_audio_default sysfs_ccci:dir search;
allow hal_audio_default sysfs_ccci:file { read open getattr };
allow hal_audio_default nvram_prop:file { read open getattr map };

# ccci_fsd walks the same sysfs directory
allow ccci_fsd sysfs_ccci:dir search;

# servicemanager reads a caller's SELinux context to police registration —
# this is how it enforces who may publish a service, so it is legitimate
allow servicemanager hal_fingerprint_default:dir search;
allow servicemanager hal_fingerprint_default:file { read open getattr };

# netd asking for sys_module is a stock habit (it probes for kernel modules
# that are built in here). Keep it denied and silent rather than granting
# module-loading rights to the network daemon.
dontaudit netd self:capability sys_module;

##############################################################################
# Round 6 (census #7, 10 denials left, 0 ioctl denials, 0 crashes).
##############################################################################

# nvram_daemon runs toybox utilities and reads the fstab to find the nvram
# partition
allow nvram_daemon toolbox_exec:file { read open execute execute_no_trans };
allow nvram_daemon rootfs:file { read open getattr };

# mnld reads the nvram property namespace for the GNSS calibration
allow mnld nvram_prop:file { read open getattr map };

# servicemanager checks the caller's process attributes while policing
# service registration
allow servicemanager hal_fingerprint_default:process getattr;

##############################################################################
# Round 7 (census #8, 9 denials left). Property-namespace reads and two
# capabilities — the tail.
##############################################################################

# the AGPS daemon reads the modem property namespace
allow mtk_agpsd mtk_md_prop:file { read open getattr map };

# ccci_mdinit reads the nvram namespace for modem calibration
allow ccci_mdinit nvram_prop:file { read open getattr map };

# thermal_manager chowns the thermal policy files it creates under /data/.tp
allow thermal_manager self:capability { chown fowner };

# the PQ service sets its own properties
unix_socket_connect(pq, property, init)

##############################################################################
# Round 8 (census #9). The composer registering on the vendor service manager,
# and its CMDQ device — the same shape as the fingerprint/servicemanager pair
# closed in round 5.
##############################################################################

# composer registers itself with vndservicemanager
allow hal_graphics_composer_default vndservicemanager:binder { call transfer };
allow vndservicemanager hal_graphics_composer_default:dir search;
allow vndservicemanager hal_graphics_composer_default:file { read open getattr };
allow vndservicemanager hal_graphics_composer_default:process getattr;

# composer drives the MTK command queue at /proc/mtk_cmdq
allow hal_graphics_composer_default proc_cmdq:file { read open getattr ioctl };

##############################################################################
# Round 9 (census #10, 8 denials). nvram_daemon reaching its own partitions,
# and one directory read.
##############################################################################

# nvram_daemon owns the NV partitions: nvdata (p9) and proinfo (p15)
allow nvram_daemon nvdata_device:blk_file { read write open getattr ioctl };
allow nvram_daemon proinfo_block_device:blk_file { read write open getattr ioctl };

# and the ADC calibration node. /dev/mtk-adc-cali carries the generic `device`
# label because nothing ever gave it one; granting on `device` would be far too
# broad, so it gets its own type and a file_contexts entry alongside.
allow nvram_daemon mtk_adc_cali_device:chr_file { read write open getattr ioctl };

# the AGPS daemon stats the nvcfg mount point
allow mtk_agpsd nvcfg_file:dir { search getattr };

##############################################################################
# Round 10 — the only thing enforcing actually broke.
#
# Switching to enforcing killed the camera provider with SIGABRT twice. The
# denials in that window were all the same shape: the MTK camera HAL writing
# lens-shading dumps to /data/media/0/shading/*.log. The blob does not treat a
# failed open as recoverable — it aborts — so these have to be allowed rather
# than silenced, or the camera dies under enforcing.
#
# Radio was a false alarm in the same window: the framework read OUT_OF_SERVICE
# because registration had not completed yet ~90 s after boot. CEREG showed 1
# (registered, home) at the modem, and a minute later the framework agreed:
# IN_SERVICE on 25002, data connected, curl to ya.ru returning 302.
##############################################################################
allow hal_camera_default media_rw_data_file:dir { search write add_name };
allow hal_camera_default media_rw_data_file:file { create write open getattr };

##############################################################################
# Round 11 — denials visible only in the kernel audit, not in logcat.
#
# Reading dmesg rather than logcat surfaced three more. It also corrected my
# previous conclusion: the camera provider aborts in BOTH permissive and
# enforcing when I pkill it and launch the app immediately, so enforcing was
# never the cause — my own test was. Same trap as the morning.
##############################################################################

# camera HAL stats its shading dump directories before writing them
allow hal_camera_default media_rw_data_file:dir getattr;

# sensors HAL persists the gyro-bias calibration and sets its own properties.
# The calibration file sits in the root of /data, so it inherits
# system_data_file, which domain.te:1181 forbids any HAL from writing. Rather
# than widen that, the matching file_contexts entry relabels this one file to
# the sensor type MTK already uses for /data/misc/sensor, and init.mt6797.rc
# restorecons it (the file already exists from earlier permissive boots).
allow hal_sensors_default mtk_sensor_data_file:file { read write open getattr create };
allow hal_sensors_default system_data_file:dir search;
unix_socket_connect(hal_sensors_default, property, init)

# The property it actually sets: nosecure.akm.resetdoe, the AKM compass DOE
# reset flag. FACT (enforcing, 2026-08-15 22:50):
#   avc: denied { set } for property=nosecure.akm.resetdoe pid=385
#        scontext=u:r:hal_sensors_default:s0 tcontext=u:object_r:default_prop:s0
#        tclass=property_service permissive=0
# Unlabelled properties fall through to default_prop, which a HAL may not set,
# so property_contexts gives the nosecure.akm. prefix its own type instead of
# widening default_prop.
set_prop(hal_sensors_default, m95_sensor_prop)

##############################################################################
# Round 14 — the last two denials left standing after the camera captured
# successfully under enforcing (15 -> 16 files in DCIM, no aborts).
##############################################################################

# cameraserver reads the GED node, same as hal_camera_default already does.
# FACT: avc: denied { read } comm="C3Dev-0-ReqQueu" name="ged"
#       scontext=u:r:cameraserver:s0 tcontext=u:object_r:proc_ged:s0
allow cameraserver proc_ged:file r_file_perms;

##############################################################################
# Round 15 — the census of the first boot that came up enforcing by default.
# 28 denials, none of which was the one that actually mattered: the combo chip
# failed on a dontaudit'ed dac_override, i.e. silently. Fixed by making
# /dev/wmtdetect root-owned rather than by granting the capability.
##############################################################################

# PQ daemon writes its own tuning knobs (now typed, see property_contexts).
set_prop(pq, m95_pq_prop)

# nvram_daemon publishes the Wi-Fi 5G capability flag.
set_prop(nvram_daemon, m95_wlan_prop)

# gsm0710muxd restarts the RIL daemons after a modem reset.
set_prop(gsm0710muxd, ctl_mtk_radio_prop)

# rild publishes which modem is active.
set_prop(rild, mtk_md_prop)

# rild walks /dev/block looking for the nvram partitions. Search only: it needs
# to resolve a path, not to enumerate or open anything here.
allow rild block_device:dir search;

# ccci_mdinit publishes modem status for the framework.
set_prop(ccci_mdinit, net_radio_prop)

# vendor_init tries to apply the dexopt policy out of /vendor/build.prop and is
# refused. domain.te:547 neverallows it, and unlike the WMT case this one is
# genuinely redundant rather than silently harmful: the same seven pm.dexopt.*
# keys appear in BOTH system/build.prop and vendor/build.prop with identical
# values, system init sets them first, and the device confirms them applied --
#   pm.dexopt.boot=verify  first-boot=quicken  install=quicken
#   bg-dexopt=speed-profile
# checked on the live device before silencing this, because the WMT regression
# in this same round was caused by a dontaudit hiding a real failure.
dontaudit vendor_init exported_pm_prop:property_service set;
dontaudit vendor_init exported_pm_prop:file { open read ioctl lock };

# mnld resolves a path through /nvcfg to reach its GNSS calibration.
allow mnld nvcfg_file:dir search;

##############################################################################
# Round 17 — what surfaced once PQ actually registered.
##############################################################################

# The camera provider now finds the PQ service and calls it. Same "found it,
# may not call it" shape as the gralloc and sensorservice pair earlier: the
# lookup and the transaction are separate checks.
# FACT: avc: denied { call } comm="MDP-0" scontext=hal_camera_default
#       tcontext=pq tclass=binder permissive=0
binder_call(hal_camera_default, pq)

# BitTube ack direction. hal_camera_default.te grants read on this socket and
# deliberately withheld write, with a stated falsifier: "a denial for { write }
# on the same tclass/tcontext". That falsifier has now fired.
# FACT: avc: denied { write } comm="Binder:793_5" path="socket:[33156]"
#       scontext=hal_camera_default tcontext=system_server
allow hal_camera_default system_server:unix_stream_socket write;

# mtk_wmtd resolving a path from a kernel thread. Non-blocking, and this time
# that is evidenced rather than assumed: with the node ownership fixed the
# combo chip reports service.wcn.driver.ready=yes, Wi-Fi associates and
# Bluetooth no longer crashes. Search only -- no read, no open.
allow kernel storage_file:dir search;

##############################################################################
# Round 18 — the camera provider now actually drives PQ, so it needs the
# knobs and the battery node it reads while doing so.
##############################################################################

# It reads and writes the PQ tuning knobs it just gained access to.
# FACT: { read } name="u:object_r:m95_pq_prop:s0" scontext=hal_camera_default
#       { set } property=debug.pq.shp.en / debug.pq.dshp.en   (pid 372)
get_prop(hal_camera_default, m95_pq_prop)
set_prop(hal_camera_default, m95_pq_prop)

# 3A reads the battery/thermal state to decide flash and frame-rate limits.
# FACT: { search } comm="3ATHREAD" name="power_supply" tcontext=sysfs_batteryinfo
allow hal_camera_default sysfs_batteryinfo:dir search;
allow hal_camera_default sysfs_batteryinfo:file r_file_perms;

##############################################################################
# Round 20 — video playback under enforcing.
#
# The player shows a fully green screen: no crash, no ANR, codec alive, and
# the decoder's output buffer simply never written (all-zero YUV reads as
# green). 74 denials fire during one playback, and these are them.
##############################################################################

# The decoder reads the GED node for its buffer/queue bookkeeping.
# FACT: { read } name="ged" comm="CodecLooper" scontext=mediaserver (34x)
allow mediaserver proc_ged:file r_file_perms;

# mediacodec looks up MTK's GUI extension service, the only entry in
# vndservicemanager on this device, to hand frames to the display path.
# FACT: { find } service=GuiExtService scontext=mediacodec (16x)
#
# Round 23: this allow is REMOVED deliberately, it is not an oversight.
#
# Granting it is what lets MtkOmxVdec reach GuiExtClientProducer::alloc(), and
# that call is where hardware video decode dies. On /dev/vndbinder the composer
# HAL sits in ComposerService::connectLocked() forever looking for a
# SurfaceFlinger that is not registered there, which deadlocks the decoder's
# only message-loop thread. Put both processes on /dev/binder instead and the
# deadlock goes, but GuiExtPoolItem::createBufferQueue then segfaults the
# composer against Pie's libgui and takes SurfaceFlinger with it.
#
# So the service is left unreachable on purpose, to find out whether the blob
# falls back to the plain native-window path when the pool is simply not
# there. A denial for it is the expected, wanted outcome -- if this turns out
# to be wrong, restore the line rather than adding a dontaudit, because
# silencing it would hide exactly the thing being measured.
# allow mediacodec guiext_service:service_manager find;

# SurfaceFlinger reads the command-queue node while compositing video.
# FACT: { read } name="mtk_cmdq" scontext=surfaceflinger (8x)
allow surfaceflinger proc_cmdq:file r_file_perms;

# The composer applies the same PQ knobs the camera does.
# FACT: { set } persist.sys.pq.* and debug.pq.* scontext=hal_graphics_composer_default
set_prop(hal_graphics_composer_default, m95_pq_prop)

# Round 21: the video decoder thread calls into the composer.
# FACT: { call } comm="MtkOmxVdecThrea" scontext=mediacodec
#       tcontext=hal_graphics_composer_default tclass=binder permissive=0
binder_call(mediacodec, hal_graphics_composer_default)

# Round 22 -- the video decoder reads the PQ properties.
#
# FACT (logcat, 2026-08-16 08:57:30, and again on every playback):
#   avc: denied { read } for comm="HwBinder:441_3"
#        name="u:object_r:m95_pq_prop:s0" dev="tmpfs" ino=348
#        scontext=u:r:mediacodec:s0 tcontext=u:object_r:m95_pq_prop:s0
#        tclass=file permissive=0
#
# comm is a HwBinder thread of omx@1.0-service, so this is the MTK OMX video
# decoder reading ro.mtk_pq* / persist.sys.pq.* while a clip is open. The
# denial appears ONLY in logcat -- `dmesg | grep avc` shows nothing for it,
# which is the second time that split has hidden something on this device.
#
# Read only. Nothing observed asks the decoder to write these, and PQ state is
# owned by the pq service and the composer (see rounds above).
#
# NOT a claim that this is why no frames come out: at the time of writing the
# decoder still renders zero frames with the buffer count corrected and the
# registrations clean. This is an enforcing regression in the video path that
# stands on its own.
get_prop(mediacodec, m95_pq_prop)

# Round 24 -- SurfaceFlinger reads the PQ properties too.
#
# FACT (logcat, 2026-08-16 10:01:12):
#   avc: denied { read } for name="u:object_r:m95_pq_prop:s0" dev="tmpfs"
#        ino=320 scontext=u:r:surfaceflinger:s0
#        tcontext=u:object_r:m95_pq_prop:s0 tclass=file permissive=0
#
# Same shape as the mediacodec denial in round 22 and the camera one before
# it: labelling the PQ properties took them away from readers that had them
# when everything was default_prop. Read only, and again visible only in
# logcat -- dmesg has nothing for it.
#
# NOT a claim that this explains the video frame drops. Overlays off changes
# nothing, the audio clock is not involved and the decoder's timestamps are
# correct, so the pacing problem is still open. This is an enforcing
# regression that stands on its own.
get_prop(surfaceflinger, m95_pq_prop)

# Round 25 -- the video decoder writes the PQ properties, not just reads them.
#
# Round 22 granted the read and left the write open, because the socket denial
# fires before the property name is ever checked and so names nothing. The
# names are now known, from the client side of the same failure:
#
#   W/libc( 450): Unable to set property "persist.sys.pq.mdp.color.dbg" to "1":
#                 connection failed; errno=13 (Permission denied)
#
# pid 450 is omx@1.0-service. The full set it tries, collected from one
# playback capture:
#
#   persist.sys.pq.mdp.color.dbg    persist.sys.pq.mdp.color.idx
#   persist.sys.pq.adl.idx          persist.sys.pq.iso.shp.en
#   persist.sys.pq.ultrares.en      debug.pq.shp.en
#   debug.pq.dshp.en                ro.mtk_pq_color_mode
#
# Every one of them carries the m95_pq_prop label already (prefixes
# persist.sys.pq., debug.pq., ro.mtk_pq), so one rule covers the set.
# ro.mtk_pq_color_mode is read-only and will keep failing on its own terms;
# that is init's business, not policy's.
#
# Why this may be more than log noise: these properties configure the MDP
# colour path, and the composer's MDP blit currently fails on every frame --
# `DpDriver: waitFramedone failed(-1)` and
# `DpAsyncBlitStream: wait complete stream failed(-26)`, 224 times in one
# capture -- which is what holds video to roughly one presented frame per
# second. A decoder that cannot configure that path is a plausible reason for
# it, so this is worth flashing and re-measuring rather than filing under
# noise. NOT a claim that it is the cause: the disconfirming test is whether
# the waitFramedone failures survive the fix.
set_prop(mediacodec, m95_pq_prop)

##############################################################################
# Round 24 (2026-09-09) — first denial census taken on 18.1 itself.
#
# Source: captures/a11-20260906/lastkmsg-v{6,7}.txt and lastkmsg-panic1.txt,
# the kernel audit of three A11 boots. Only the kernel ring was captured, so
# this list is short by construction: service_manager and property denials go
# to logcat only (see the note in pq.te) and are still uncensused on 18.1.
##############################################################################

# The camera provider opens /dev/vndbinder. FACT (three boots, two inodes):
#   avc: denied { open read write ioctl } path="/dev/vndbinder"
#        scontext=u:r:hal_camera_default:s0 tcontext=u:object_r:vndbinder_device:s0
# Same standing as the DRM, GNSS and composer grants above: a vendor domain on
# the vendor binder is the sanctioned arrangement, and hal_camera_default is a
# vendor domain here.
#
# Caveat, deliberately recorded rather than hidden: these captures predate
# tools/patches/camera-provider-framework-binder.patch landing on 18.1, which
# moves the provider's own ProcessState to /dev/binder. The rule may therefore
# be vestigial for the provider proper -- but MTK libraries loaded into it
# (libcam.camadapter, libgem) construct their own ProcessState, so it is not
# safe to drop without a fresh census on a build that carries the patch.
vndbinder_use(hal_camera_default)
