# audio.primary.mt6797 inside audio@2.0-service.
# The CCCI voice-call PCM nodes are labelled audio_device (see file_contexts,
# matching stock ueventd ownership audio:audio [DEV]); base policy already
# grants hal_audio audio_device. Extras below are [CONV].

r_dir_file(hal_audio_default, nvdata_file)
allow hal_audio_default nvdata_file:file rw_file_perms;
allow hal_audio_default sysfs:file r_file_perms;
allow hal_audio_default sysfs_dev_info:file r_file_perms;

##########################
# DELIBERATELY LEFT DENIED — /sdcard/.audio_param. NO RULE, ON PURPOSE.
#
# FACT (live device, 2026-08-10, seen by all four provocation sweeps, on a 1 Hz
# retry loop that never stops):
#   avc: denied { search } scontext=u:r:hal_audio_default:s0
#        tcontext=u:object_r:storage_file:s0  tclass=dir  name="default"
#   avc: denied { read }   ... tcontext=u:object_r:storage_file:s0
#        tclass=lnk_file  name="primary"
#   avc: denied { search } ... tcontext=u:object_r:mnt_user_file:s0
#        tclass=dir  name="user"
#   avc: denied { read }   ... tcontext=u:object_r:mnt_user_file:s0
#        tclass=lnk_file  name="primary"
#   avc: denied { search } ... tcontext=u:object_r:sdcardfs:s0
#        tclass=dir  name="/"
#
# This is AudioParamParser looking for /sdcard/.audio_param. Allowing it would
# switch ON MediaTek's drop-an-XML-on-the-sdcard-and-retune-the-audio-HAL hook,
# which commit 94f9e1e examined and refused on security grounds — any process
# that can write external storage would be able to reconfigure the audio HAL.
# The Pie-era ramdisk default.prop carried the same instruction ("DO NOT fix
# this by giving the HAL sdcard_rw/media_rw"; git show 0420a7d:rootdir/
# default.prop, line 125 -- the file was never installed on A11+ and is gone).
#
# The enforcing behaviour is the DESIRED behaviour, which is why this is the one
# denial in the sweep that must survive it: under enforcing the search fails
# hard, the parser stops retrying, and the 1 Hz log flood ends by itself. The
# rule to write here is no rule.
#
# 2026-08-14: dontaudit added below — it is NOT an allow. The access stays
# denied (identical enforcing outcome), only the audit record is suppressed,
# which also works under permissive and removes the ~9 avc lines/min this loop
# prints today (audio lane count, dmesg window 12:54-12:55). If this path ever
# needs re-examination, comment the dontaudit lines out and the denials
# reappear.
dontaudit hal_audio_default { storage_file mnt_user_file sdcardfs }:dir search;
dontaudit hal_audio_default { storage_file mnt_user_file }:lnk_file read;
binder_use(hal_audio_default)
allow hal_audio_default audioserver_service:service_manager find;
# If a follow-up denial `hal_audio_default → audioserver:binder call` appears
# under enforcing, base policy's binder_call(hal_audio_server, hal_audio_client)
# should already cover it (audioserver is hal_audio_client); re-check before
# adding anything here.
