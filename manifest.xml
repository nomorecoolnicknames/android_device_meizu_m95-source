<!-- m95 device manifest, LineageOS 20 (Android 13).  Carried over unchanged
     from the 18.1 tree of this device, because the version map it encodes is
     about the N-era mt6797 blobs, not about the platform: composer@2.1 +
     HWC2On1Adapter, mapper@2.1 + Gralloc0Hal, camera 2.4 legacy, audio under
     audio@6.0-impl in-process.  The audio block was already written for
     Android 13 (see the comment below it).

     target-level 1 = the Android 8.0 framework compatibility matrix, the
     loosest one, chosen while the blobs are being adapted.  NOT yet verified
     against Android 13: PRODUCT_ENFORCE_VINTF_MANIFEST is true here
     (it follows PRODUCT_FULL_TREBLE) and `check_vintf_all` only runs when the
     images are built, not during `m nothing`.  Entries for HALs whose service
     ships its own VINTF fragment (wifi@1.0-service, gatekeeper@1.0-
     service.software, fingerprint@2.0-service.m95) are deliberately absent:
     the build merges those fragments into this manifest. -->

<manifest version="1.0" type="device" target-level="3">
    <!-- Both 2.0 and 6.0 are declared, and both impls are installed: the
         combined android.hardware.audio.service registers the FIRST version
         whose impl library is present, i.e. 6.0, and falls back to 2.0 only if
         6.0 fails to load. Android 13's audio client only knows 7.1/7.0/6.0/
         5.0/4.0 (frameworks/av/media/libaudiohal/FactoryHalHidl.cpp), and it
         requires the audio AND effect factories at the SAME major version -
         with 2.0 alone createPreferredImpl() returns nullptr and there is no
         sound at all. -->
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <version>6.0</version>
        <interface>
            <name>IDevicesFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport>hwbinder</transport>
        <version>6.0</version>
        <interface>
            <name>IEffectsFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <version>2.0</version>
        <interface>
            <name>IDevicesFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport>hwbinder</transport>
        <version>2.0</version>
        <interface>
            <name>IEffectsFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.biometrics.fingerprint</name>
