//
// Thermal HAL 2.0 for the MX6, built on the AOSP mock
// (hardware/interfaces/thermal/2.0/default), but reporting real sensors only.
// Without any thermal HAL the framework had none (ThermalManagerService
// "HAL Ready=false", meizu-fleet kernels/mx6-repair-20261002/thermal-ims).
// Throttling stays with the legacy MTK daemons (init.m95.thermal.rc): this HAL
// reports temperatures and CPU usage and declares no thresholds, so it never
// drives the framework's thermal status by itself. Sensor choice and units:
// Thermal.cpp, kSensors.
cc_binary {
    name: "android.hardware.thermal@2.0-service.m95",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.thermal@2.0-service.m95.rc"],
    vintf_fragments: ["android.hardware.thermal@2.0-service.m95.xml"],
    srcs: [
        "Thermal.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "libutils",
        "android.hardware.thermal@2.0",
        "android.hardware.thermal@1.0",
    ],
}
