# genfs_contexts — Meizu MX6 (m95), MT6797.

# /proc/m4u — FACT: kernel/m685 m4u.c:2626 proc_create("m4u"). The Pie base
# policy no longer labels /m4u (same finding as the m681 LOS16 port).
genfscon proc /m4u u:object_r:mtk_m4u_proc:s0

# WMT debug/trigger entries — FACT: kernel/m685 connectivity driver creates
# proc_create("driver/wmt_dbg") and "driver/wmt_aee".
genfscon proc /driver/wmt_dbg u:object_r:mtk_wmt_proc:s0
genfscon proc /driver/wmt_aee u:object_r:mtk_wmt_proc:s0

# CCCI modem status attrs — FACT: /sys/kernel/ccci referenced by stock ueventd.
genfscon sysfs /kernel/ccci u:object_r:sysfs_ccci:s0

# LED class devices. The base policy labels /sys/class/leds (symlinks); the
# real attrs live under the mt65xx_leds platform device — FACT: backlight path
# /sys/class/leds/lcd-backlight verified live (DEVICE_FACTS.md), platform
# device path from rootdir/ueventd.mt6797.rc.
genfscon sysfs /devices/platform/leds-mt65xx u:object_r:sysfs_leds:s0

# Meizu sensor class devices — FACT: kernel/m685 drivers/base/meizu-sys.c
# creates class "meizu"; devices with no parent land under /sys/devices/virtual.
# (INFERENCE on the exact /devices/virtual path — verify with a live ls.)
genfscon sysfs /devices/virtual/meizu u:object_r:sysfs_meizu:s0

# Battery: the fuel gauge is a bq27532 i2c device (kernel/m685
# power/mt6797/bq27532_battery.c), so its power_supply sysfs path contains an
# unstable i2c segment. Label the class dir; refine to the device path once a
# live boot shows it.
genfscon sysfs /class/power_supply u:object_r:sysfs_batteryinfo:s0

# ...and here is that live boot. The /class entry above is NOT enough on its
# own: /sys/class/power_supply/battery is a symlink, and genfscon labels the
# real inode, so every attribute read through it resolves to the /devices path
# and lands on plain `sysfs`.
#
# FACT (live device, 2026-08-10):
#   avc: denied { read open getattr } for
#        path="/sys/devices/platform/battery/power_supply/battery/present"
#        dev="sysfs" scontext=u:r:healthd:s0 tcontext=u:object_r:sysfs:s0
#        tclass=file  permissive=1                                    (x24)
#
# No allow rule is needed and none is written: system/sepolicy/public/healthd.te:32
# already carries r_dir_file(healthd, sysfs_batteryinfo), and hal_health.te:22
# states outright that labelling the battery attributes is the vendor's job.
# The label is the whole fix.
#
# Without it, under enforcing: healthd cannot read `present`, so it treats the
# battery as absent. That is not cosmetic - healthd drives charging UI, the
# low-battery shutdown path and BatteryService, and an absent battery is the
# state that makes it stop reporting capacity entirely.
#
# Scope is the battery's power_supply subtree rather than the single denied
# file, deliberately: healthd polls the whole attribute set (capacity, status,
# health, voltage_now, temp), `present` is simply the one that shows up in this
# boot's log, and sysfs_batteryinfo is readable only by healthd, charger,
# hal_health_server and perfprofd - exactly the set that should see it.
genfscon sysfs /devices/platform/battery/power_supply u:object_r:sysfs_batteryinfo:s0


# MTK GPU extension device + command queue + thermal driver tree — FACT
# (2026-08-14 census): live denials name /proc/ged (ioctl from 9 domains),
# /proc/mtk_cmdq (camera MDP-0 ioctl 0x7805, MtkOmx read) and
# /proc/driver/thermal/mdm_mdinfoex_thre (vendor thermal daemon, currently in
# init's domain). Types declared in file.te.
genfscon proc /ged u:object_r:proc_ged:s0
genfscon proc /mtk_cmdq u:object_r:proc_cmdq:s0
genfscon proc /driver/thermal u:object_r:proc_mtk_thermal:s0

# MTK CPU hotplug governor. m95-cpuset.sh writes /proc/hps/enabled (hps off, all
# cores online -- see the BRING-UP block there for why); the memory note
# `m95-a11-mali-region-layout-and-hps-panic` records the panic behind it.
# Labelled so a domain may be granted it without opening generic /proc.
genfscon proc /hps u:object_r:proc_hps:s0

genfscon proc /last_kmsg u:object_r:m95_proc_last_kmsg:s0
genfscon proc /sys/vm/swappiness u:object_r:m95_proc_swappiness:s0
genfscon debugfs /ged/hal/custom_boost_gpu_freq u:object_r:m95_debugfs_ged_boost:s0

genfscon proc /ppm u:object_r:m95_proc_ppm:s0
genfscon proc /cpufreq u:object_r:m95_proc_cpufreq:s0
genfscon proc /perfmgr u:object_r:m95_proc_perfmgr:s0
genfscon proc /mtkcooler u:object_r:m95_proc_mtkcooler:s0

# firmware_class search path, written at early-init (init.mt6797.rc).
genfscon sysfs /module/firmware_class/parameters/path u:object_r:sysfs_fw_class_path:s0
