# system.prop — Meizu MX6 (m95) on LineageOS 20 (Android 13). System-side properties.
# StrictMode off for system processes (userdebug WTF dialog covered the
# screen every boot — FACT, LOS16 tree).
persist.sys.strictmode.disable=true

# Force framework VoLTE-available gate for bring-up (phh/GSI override;
# forces OUR side only, not the network — FACT, LOS16 tree).
persist.dbg.volte_avail_ovr=1

# SurfaceFlinger keeps a continuous transaction trace on non-user builds
# (SurfaceFlinger.cpp:450-451); this product is userdebug (M95_PERF_AUDIT P1-3).
debug.sf.enable_transaction_tracing=false

# Privacy: framework and ForgeImsService (donor code, kept unmodified) tags that
# print the ICCID or numbers at DEBUG (FACT, radio captures 25-26.09; the vendor
# half and the rationale are in vendor.prop next to log.tag.AT).
#   SubscriptionController  ICCID, own number
#   SuppServExt, ImsConfigManager  ICCID;  ImsUtImpl  call-forwarding number
#   @M_ImsSimservsDispatcher  own IMS identity (XUI)
log.tag.SubscriptionController=I
log.tag.SuppServExt=I
log.tag.ImsConfigManager=I
log.tag.ImsUtImpl=I
log.tag.@M_ImsSimservsDispatcher=I
debug.renderengine.backend=gles

ro.adb.nonblocking_ffs=false

# adb on USB from the first boot. build/make/tools/post_process_props.py:31-40
# adds this only when ro.adb.secure=0, so with authorisation on (the default
# since #28, device.mk M95_INSECURE_ADB) adb would start switched off and the
# keys in /adb_keys would be useless. Authorisation still applies: computers
# not in /adb_keys are asked for on the screen. Here and not in vendor.prop for
# the reason given above (vendor_init may not set it).
persist.sys.usb.config=adb
