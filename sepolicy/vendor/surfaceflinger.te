
# The composer process is the observed vndbinder-side consumer
# (BpServiceManager::getService loop in Binder:378_2, capture venc_stk378.txt).
# Its binder_call to surfaceflinger is already covered by the platform
# hal_graphics_composer client/server attribute rules.
allow hal_graphics_composer_default surfaceflinger_vndservice:service_manager find;
