# Goodix fingerprint daemon -- /vendor/bin/goodixfingerprintd.
#
# 2026-09-24 (Android 13, SELinux lane): the daemon has a VENDOR domain of its
# own, goodixfpd, instead of the platform `fingerprintd` it was pinned into by
# `seclabel` since LOS16. fingerprintd is a coredomain (private/
# fingerprintd.te), fingerprintd_exec is system_file_type, and a coredomain
# may not execute /vendor files (public/domain.te, full_treble_only), so no
# rule could make that pairing legal -- the blocker SELINUX_ENFORCING_PLAN.md
# §4.2 recorded on 18.1. FACT (both captures), scontext=fingerprintd:
#   { entrypoint } path=/vendor/bin/goodixfingerprintd tcontext=vendor_file
#   { execute open read } libgf_hal.so (vendor_file), libm95shim_utils.so
#   (same_process_hal_file), libbinder.so (113630, before 8d35fea)
#   { open read write ioctl } /dev/vndbinder, { call transfer } vndservicemanager
#   { add } android.hardware.fingerprint.IGoodixFingerprintDaemon on
#   default_android_vndservice
# and, from the HAL side, hal_fingerprint_default { find } on the same name,
# vndbinder and a vndservicemanager call. On A13 the daemon links the VNDK
# libbinder, so its ProcessState is /dev/vndbinder and the service lives in
# vndservicemanager -- the Treble-correct vendor-to-vendor shape.
# Under enforcing before this change the daemon did not start at all.
#
# goodixfpd.rc drops its seclabel line; the exec label does the transition.
# No keystore: the binary carries no keystore strings, auth tokens travel
# HAL -> framework.

type goodixfpd, domain;
type goodixfpd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(goodixfpd)

vndbinder_use(goodixfpd)
add_service(goodixfpd, goodixfpd_vndservice)

vndbinder_use(hal_fingerprint_default)
allow hal_fingerprint_default goodixfpd_vndservice:service_manager find;

##########################
# fingerprint.default.so (dlopened by the @2.0-service, i.e.
# hal_fingerprint_default) is the only client of the daemon's service.

# IGoodixFingerprintDaemonCallback means traffic runs both ways: the HAL calls
# in to enroll/authenticate, the daemon calls back with results.
binder_call(hal_fingerprint, goodixfpd)
binder_call(goodixfpd, hal_fingerprint)

##########################
# Sensor + TEE. /dev/goodix_fp is 230,0 system:system 0660, labelled
# fingerprint_device by sepolicy/file_contexts [DEV: verified live on device].
# The daemon opens it directly and drives the sensor through libgf_hal; it is
# also the only writer of GF_IOC_INPUT_KEY_EVENT, which is what turns an mBack
# tap into KEY_BACK on the fp-keys input node (see keylayout/fp-keys.kl).
allow goodixfpd fingerprint_device:chr_file rw_file_perms;

# Crypto path: libgf_ca -> libMcClient -> /dev/mobicore-user + the mcd socket.
# Identical to the chain live keymaster@3.0 and gatekeeper@1.0 already use
# (see sepolicy/tee.te).
allow goodixfpd mobicore_user_device:chr_file rw_file_perms;
allow goodixfpd mcd:unix_stream_socket connectto;
r_dir_file(goodixfpd, mcd_data_file)

##########################
# Template / calibration store. FACT: proprietary/lib64/libgf_hal.so contains
# /data/gf_data/{authenticate,base/finger_base,base/nav_base,consistency,
# enroll,navigation,test_sensor}/ as literals. goodixfpd.rc creates the root
# 0700 system system; the daemon creates the subtree itself.
allow goodixfpd gf_data_file:dir create_dir_perms;
allow goodixfpd gf_data_file:file create_file_perms;

##########################
# Self-binder (the daemon hands binder objects to its own callback thread) and
# property_service, which the daemon reaches through init's socket.

##########################
# Netlink socket to the Goodix driver — this is the finger-touch path itself.
#
# FACT (live device, 2026-08-10): the daemon trips
#   avc: denied { read } scontext=u:r:fingerprintd:s0 tcontext=u:r:fingerprintd:s0
#        tclass=netlink_socket permissive=1
# repeatedly. It proceeds today only because SELinux is permissive.
#
# This is not cosmetic. gf_irq() in
# drivers/misc/mediatek/fingerprint/goodix_tee/gf/gf_spi_tee.c does exactly one
# thing on a sensor interrupt: push a netlink message. Every finger event —
# touch, image-ready, and the GF_IOC_INPUT_KEY_EVENT round-trip that produces
# mBack's KEY_BACK — reaches userspace through this socket and nothing else.
# Under enforcing, without these rules, the daemon would start, register its
# binder service and look healthy while never learning that a finger touched
# the sensor: no enrolment, no authentication, and a dead mBack tap.
#
# Same class of latent-under-permissive defect as the LSC shading cache and the
# akmd_set.txt calibration store: invisible now, fatal at the moment enforcing
# is switched on, which is exactly when nobody is looking for it.
allow goodixfpd self:netlink_socket { create bind read write setopt };

##########################
# 2026-08-14 census: the LOS @2.0 HAL service (not the goodix daemon) writes
# the legacy fpdata store — FACT: { write } dir name="fpdata"
# scontext=u:r:hal_fingerprint_default:s0 tcontext=fingerprintd_data_file
# (comm fingerprint@2.0, x2). The dlopened blob keeps template metadata next
# to where fingerprintd keeps its own; under enforcing enrolment would fail
# at the first template write with nothing in the UI to say why.
allow hal_fingerprint_default fingerprintd_data_file:dir rw_dir_perms;
allow hal_fingerprint_default fingerprintd_data_file:file create_file_perms;
