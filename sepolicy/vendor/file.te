# Type declarations — Meizu MX6 (m95), MT6797, LineageOS 16.0.
# See file_contexts for the [DEV]/[CONV] evidence tag of each label target.

##########################
# Block devices
type nvram_device, dev_type;
type nvdata_device, dev_type;
type protect_f_device, dev_type;
type protect_s_device, dev_type;
type expdb_block_device, dev_type;
type logo_block_device, dev_type;
type seccfg_block_device, dev_type;
type proinfo_block_device, dev_type;
type lk_block_device, dev_type;
type mdimg_block_device, dev_type;

##########################
# Character devices
type stpwmt_device, dev_type;
type wmtdetect_device, dev_type;
type wmtWifi_device, dev_type;
type stpbt_device, dev_type;
type spm_device, dev_type;
type stpgps_device, dev_type;
type fm_device, dev_type;
type ccci_device, dev_type;
type sw_sync_device, dev_type;
type MTK_SMI_device, dev_type;
type camera_isp_device, dev_type;
type cam_cal_device, dev_type;
type hwmsensor_device, dev_type;
type fingerprint_device, dev_type;
type mobicore_device, dev_type;
type mobicore_user_device, dev_type;
type otp_device, dev_type;
type mtgpio_device, dev_type;
type irtx_device, dev_type;
type touch_device, dev_type;
type hotknot_device, dev_type;
type hang_detect_device, dev_type;
# /dev/devmap — read-only devinfo (efuse) map, kernel devinfo.c device_create.
# [FACT 2026-08-18, log-audit] consumers by blob strings: libcam.halsensor.so
# (camera provider) and libvcodec_oal.so (mediacodec); see file_contexts.
type devmap_device, dev_type;

##########################
# File / data types
type nvdata_file, file_type, data_file_type, core_data_file_type;
type nvcfg_file, file_type;
type protect_f_data_file, file_type, data_file_type;
type protect_s_data_file, file_type, data_file_type;
type mnld_data_file, file_type, data_file_type, core_data_file_type;
type mtk_sensor_data_file, file_type, data_file_type, core_data_file_type;
type mcd_data_file, file_type, data_file_type, core_data_file_type;
# /data/gf_data — Goodix template/calibration store. FACT: the seven paths
# /data/gf_data/{authenticate,base/finger_base,base/nav_base,consistency,
# enroll,navigation,test_sensor}/ are string constants in
# proprietary/lib64/libgf_hal.so, which goodixfingerprintd loads. Nothing in
# AOSP, LOS or the stock ramdisk we have creates or labels this tree (checked:
# no `gf_data` anywhere in stock/, analysis/ or device/meizu/m681), so without
# this type it would inherit system_data_file from /data and be unwritable by
# fingerprintd once SELinux is enforcing.
type gf_data_file, file_type, data_file_type, core_data_file_type;

##########################
# proc / sysfs types
# /proc/m4u — FACT: kernel/m685 m4u.c proc_create("m4u"). The Pie base policy
# does not label it (the m681 LOS16 port hit the same gap).
type mtk_m4u_proc, fs_type, proc_type;
# /proc/driver/wmt_dbg + wmt_aee — FACT: kernel/m685 connectivity driver.
type mtk_wmt_proc, fs_type, proc_type;
# /sys/kernel/ccci — FACT: exported by the CCCI driver, listed in stock ueventd.
type sysfs_ccci, fs_type, sysfs_type;
# /sys/devices/virtual/meizu — FACT: kernel/m685 drivers/base/meizu-sys.c
# class_create("meizu"); the alsps sensor HAL reads /sys/class/meizu/{als,ps}.
type sysfs_meizu, fs_type, sysfs_type;
# [CONV] m681-template dev_info sysfs node, unverified on m95.
type sysfs_dev_info, fs_type, sysfs_type;
type sysfs_fw_class_path, fs_type, sysfs_type;

##########################
# Executables (domains declared in their own .te files)
type nvram_daemon_exec, exec_type, vendor_file_type, file_type;
type nvram_agent_binder_exec, exec_type, vendor_file_type, file_type;
type wmt_loader_exec, exec_type, vendor_file_type, file_type;
type wmt_launcher_exec, exec_type, vendor_file_type, file_type;
type wmt_concurrency_exec, exec_type, vendor_file_type, file_type;
type mnld_exec, exec_type, vendor_file_type, file_type;
type mtk_agpsd_exec, exec_type, vendor_file_type, file_type;
type mcd_exec, exec_type, vendor_file_type, file_type;
type fuelgauged_exec, exec_type, vendor_file_type, file_type;
type batterywarning_exec, exec_type, vendor_file_type, file_type;
type ccci_fsd_exec, exec_type, vendor_file_type, file_type;
type ccci_mdinit_exec, exec_type, vendor_file_type, file_type;
type emdlogger_exec, exec_type, vendor_file_type, file_type;
type flashlessd_exec, exec_type, vendor_file_type, file_type;
type gsm0710muxd_exec, exec_type, vendor_file_type, file_type;
type mdlogger_exec, exec_type, vendor_file_type, file_type;
type rilproxy_exec, exec_type, vendor_file_type, file_type;
type statusd_exec, exec_type, vendor_file_type, file_type;
type terservice_exec, exec_type, vendor_file_type, file_type;
type viarild_exec, exec_type, vendor_file_type, file_type;

# Magnetometer calibration cache. The AKM daemon inside the sensors HAL reads
# and writes /data/misc/akmd_set.txt to persist compass calibration across
# reboots. It inherits system_data_file from /data/misc, which hal_sensors_default
# may not write, so it needs a type of its own.
type sensor_calib_file, file_type, data_file_type, core_data_file_type;

# Modem OEM control socket, /dev/socket/rild-oem (declared in
# rootdir/init.m95.modem.rc:139). Its own type, deliberately NOT the AOSP
# rild_socket: that type is already reachable by every existing rild_socket
# consumer including the radio/phone domain, so reusing it would hand the phone
# app the modem's OEM thermal-control channel. The only client here is
# /vendor/bin/thermal.
type rild_oem_socket, file_type;

# The MTK IMS command socket, /dev/socket/rild-ims (declared in
# rootdir/init.m95.modem.rc:137, listener = librilmtk's IMS_RILA_register in
# the rild process). Same pattern and same reasoning as rild_oem_socket
# above: without its own type the node falls through to socket_device, and
# its first client — volte_kicker (volte_kicker.te) — would need a blanket
# socket_device:sock_file write. When an ImsService APK ever lands, its
# domain gets write on this type by census, not in advance.
type rild_ims_socket, file_type;

# /dev/socket/rild-mal — сокет, объявленный у сервиса rild. В стоке на нём
# сидит MTK RIL и обслуживает MAL: mtkmal ходит туда через libmal_rilproxy
# классическим кадром RIL. Мы направляем MAL прямо сюда (ril.mal.socket в
# system.prop), минуя ril-proxy. Без своего типа узел падает в socket_device
# — измерено на rilproxy-mal, когда сервис поднимали живьём:
#   denied { write } name="rilproxy-mal" scontext=u:r:mtkmal:s0
#                    tcontext=u:object_r:socket_device:s0 tclass=sock_file
type rild_mal_socket, file_type;

# /dev/socket/wod_{action,sim,ipsec} — сокеты демона ePDG (epdg_wod). Их клиент
# — сущность ePDG внутри mtkmal (libmal_epdga: "Initializing connection to
# ePDGd"). Без своего типа узлы падают в socket_device, и подключение
# запрещается — измерено 2026-08-25, раз в секунду:
#   denied { write } name="wod_action" scontext=u:r:mtkmal:s0
#                    tcontext=u:object_r:socket_device:s0 tclass=sock_file
# Пока сущность не подключится, MAL считает ePDG неготовым (Epdgs(0)), и
# менеджер данных не передаёт стеку уведомление о поднятом IMS-канале:
#   dm_send_to_rb skip when epdg not support
# — а без него IMCB не запрашивает P-CSCF, и регистрация не начинается.
type epdg_wod_socket, file_type;

# /data/ipsec — рабочий каталог демона ePDG (создаётся в init.wod.rc как
# root:root 0700). Без своего типа он system_data_file, и демон каждые
# несколько секунд получает denied { write } name="ipsec" и
# denied { read } name="wo", после чего "create file /data/ipsec/wo_apn.conf
# failed" и "[SKT] restart daemon" — то есть перезапускается по кругу.
type epdg_wod_data_file, file_type, data_file_type, core_data_file_type;

##########################
# Added by the 2026-08-14 denial census (captures/m95-sepolicy-20260814/).

# /proc/ged — MTK GPU extension device (kernel/m685 drivers/misc/mediatek/gpu
# ged proc entry). Every GLES client talks to it: composer, allocator,
# surfaceflinger, bootanim, mediacodec, the camera provider, system_server and
# app RenderThreads all showed ioctl denials on the generic `proc` label
# (ioctlcmds 0x6700-0x6767). A dedicated type is the only shape that can be
# granted to app domains without opening all of /proc.
type proc_ged, fs_type, proc_type;

# /proc/mtk_cmdq — MTK command-queue (MDP/display pipeline). Camera MDP
# threads ioctl it (0x7805), MtkOmx codecs read it.
type proc_cmdq, fs_type, proc_type;

# /proc/driver/thermal — MTK thermal driver tree. Read today by the vendor
# thermal daemons, which still run in init's domain (see init.te); typed so
# the grant does not have to be "init may read all of proc".
type proc_mtk_thermal, fs_type, proc_type;

# mtkmal's own control sockets: /dev/socket/mal-mfi + volte_imsm (service
# mal-daemon) and their ril.mal=2 chiptest twins mal-mfi-dongle +
# volte_imsm_dongle (service md-daemon), all created by init from
# /vendor/etc/init/init.mal.rc. [FACT 2026-08-18 census #2: 640x avc denied
# { write } name="mal-mfi" tclass=sock_file tcontext=socket_device from
# u:r:mtkmal:s0 — the loaded entities connect back into their own daemon's
# listening sockets as clients.] Own type on the rild_oem_socket pattern: a
# blanket socket_device:sock_file write would let mtkmal into every
# unlabelled socket on the device (mnld, agpsd, wpa, ...). The future IMS
# APK client of volte_imsm will need write on this type too — granted by
# census when it lands, not now.
type mtkmal_socket, file_type;

# MTK hotplug governor: /proc/hps/{enabled,...}. Unlabelled it is plain `proc`,
# which private/coredomain.te:99 forbids every core domain from touching, so the
# node has a type of its own rather than an exemption; m95-cpuset.sh writes
# /proc/hps/enabled (m95_scripts.te). [CONV: MTK hps procfs]
type proc_hps, fs_type, proc_type;

# The VoLTE daemons' init-created rendezvous sockets (volte_daemons.te,
# 2026-08-21 census #1). Owner types on the mtkmal_socket pattern, grouped by
# owning service — volte_imcb's five channels (imsa1/2, imsvt1/2, ut, see
# rootdir/init.m95.volte.rc) share one type: same owner, same future clients
# (the Java IMS half).
type volte_stack_socket, file_type;
type volte_ua_socket, file_type;
type volte_imcb_socket, file_type;


# /data/ccci_cfg -- modem config store, mkdir'd by init.m95.modem.rc:47 and
# read by ccci_mdinit. FACT (192234): denied { getattr } path=/data/ccci_cfg
# scontext=ccci_mdinit tcontext=system_data_file; 113630: vendor_init
# { create } name=ccci_cfg on system_data_file. Own type: a vendor daemon on
# generic system_data_file is exactly what domain.te forbids.
type ccci_cfg_file, file_type, data_file_type, core_data_file_type;

# /proc/last_kmsg -- the MTK 3.18 kernel still exports it and the platform
# init.rc chowns/chmods it; A13 has no type for it, so it is plain `proc`,
# which private/coredomain.te forbids to core domains. FACT (both captures):
# denied { setattr } name=last_kmsg scontext=init tcontext=proc, and (192234)
# { read open getattr } path=/proc/last_kmsg scontext=system_server
# (BootReceiver's SYSTEM_LAST_KMSG dropbox entry).
type m95_proc_last_kmsg, fs_type, proc_type;

# /proc/sys/vm/swappiness -- init.m95.mem.rc:14 writes 100 for zram. A13
# labels a handful of /proc/sys/vm knobs, not this one, and vendor_init may
# write only proc_net_type and proc_page_cluster among proc types. FACT (both
# captures): denied { write } name=swappiness scontext=vendor_init
# tcontext=proc. Under enforcing the write fails and zram swapping falls back
# to the kernel default of 60.
type m95_proc_swappiness, fs_type, proc_type;

# /sys/kernel/debug/ged/hal/custom_boost_gpu_freq -- GPU frequency floor
# written by init.m95.mem.rc:27. FACT (192234): denied { write } scontext=
# vendor_init tcontext=debugfs. This 3.18 kernel labels debugfs by path
# (security/selinux/hooks.c:737, SE_SBGENFS), so one file can get a type.
type m95_debugfs_ged_boost, fs_type, debugfs_type;

type m95_proc_ppm, fs_type, proc_type;
# /proc/cpufreq -- MTK cpufreq driver (cpufreq_power_mode).
type m95_proc_cpufreq, fs_type, proc_type;
# /proc/perfmgr -- MTK touch boost (touch/tb_freq).
type m95_proc_perfmgr, fs_type, proc_type;
# /proc/mtkcooler -- per-cooler conditions of the MTK thermal monitor
# (EXIT hysteresis). thermal_manager writes the same files from the .tp
# policies; its generic `proc` grant (m95_enforcing.te) moves to this type
# in thermal.te.
type m95_proc_mtkcooler, fs_type, proc_type;
